{
  "name": "meddies-health-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:win": "vite --mode local-node",
    "test:local-runtime": "node --test tests/local-runtime.test.mjs",
    "build": "bash scripts/build-verified.sh",
    "build:win": "vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:win": "vinext start",
    "backend:win": "node scripts/start-backend.mjs",
    "backend:demo": "node scripts/start-backend.mjs --demo",
    "backend:local": "node scripts/start-backend.mjs --baseline",
    "local": "node scripts/start-local.mjs",
    "backend:task": "node scripts/backend-task.mjs",
    "backend:test": "node scripts/backend-task.mjs -m pytest",
    "local:doctor": "node scripts/backend-task.mjs --baseline -m scripts.doctor",
    "local:prepare": "node scripts/backend-task.mjs --baseline -m scripts.prepare_local",
    "eval:safety": "node scripts/backend-task.mjs -m evals.evaluate_safety",
    "eval:system": "node scripts/backend-task.mjs -m evals.evaluate_system",
    "eval:rag": "node scripts/backend-task.mjs --baseline -m evals.evaluate_rag --cases evals/starter_rag_cases.yaml --output reports/rag.json --min-recall 0.85 --min-mrr 0.75",
    "typecheck": "tsc --noEmit",
    "lint:win": "eslint app tests scripts/*.mjs --max-warnings 0",
    "test:unit": "node --experimental-strip-types --test tests/consultation.test.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "test:win": "npm run typecheck && npm run lint:win && npm run test:unit && npm run build:win && npm run validate:artifact:win && node --test tests/rendered-html.test.mjs",
    "validate:artifact:win": "node scripts/validate-artifact.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Meddies Health AI"
}
