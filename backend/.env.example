# Crisis line shown with self-harm replies (verify with the operator before use),
# e.g. MEDDIES_CRISIS_LINE=Đường dây Ngày Mai 096 306 1414
MEDDIES_CRISIS_LINE=
MEDDIES_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Limits apply per process; enforce shared quotas at ingress for multiple workers.
MEDDIES_MAX_REQUEST_BYTES=262144
MEDDIES_BODY_TIMEOUT_SECONDS=15
MEDDIES_RATE_WINDOW_SECONDS=60
MEDDIES_RATE_GLOBAL=120
MEDDIES_RATE_TRIAGE=120
MEDDIES_RATE_CONSULTATION=20
MEDDIES_RATE_RAG_SEARCH=60
MEDDIES_RATE_MAX_CLIENTS=4096
MEDDIES_MAX_INFLIGHT_REQUESTS=8
MEDDIES_MODEL_PROVIDER=transformers
MEDDIES_BASE_MODEL=Qwen/Qwen3-1.7B
MEDDIES_MODEL_DTYPE=bfloat16
MEDDIES_MODEL_PATH=models/stage1_consult/final_adapter
MEDDIES_RAG_ENABLED=true
MEDDIES_RAG_INDEX_PATH=data/rag_index
MEDDIES_EMBEDDING_MODEL=BAAI/bge-m3
MEDDIES_EMBEDDING_DEVICE=cpu
MEDDIES_RAG_DENSE_TOP_K=30
MEDDIES_RAG_SPARSE_TOP_K=30
MEDDIES_RAG_FUSION_TOP_K=20
MEDDIES_RAG_FINAL_K=4
MEDDIES_EMERGENCY_COUNTRY=VN
MEDDIES_EMERGENCY_PHONE=115
MEDDIES_LOG_CONTENT=false
MEDDIES_MAX_GENERATIONS=1
MEDDIES_MAX_NEW_TOKENS=384
MEDDIES_TEMPERATURE=0.3
MEDDIES_TOP_P=0.9
MEDDIES_REPETITION_PENALTY=1.05
MEDDIES_ATTENTION_IMPLEMENTATION=sdpa
MEDDIES_MAX_CONTEXT_TOKENS=4096
MEDDIES_LOCAL_FILES_ONLY=false
MEDDIES_ALLOW_UNGROUNDED=false
MEDDIES_RAG_RERANKER=cross_encoder
MEDDIES_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MEDDIES_RERANKER_DEVICE=cpu
